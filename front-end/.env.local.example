# Copy this file to .env.local (already gitignored) to override the
# defaults in .env without committing your changes. .env.local wins.

# Point at the local Docker Compose backend instead of Render:
VITE_API_PROXY_TARGET=http://localhost:8080

# If you ever build/host the frontend (not `npm run dev`), the proxy above
# doesn't apply — you'd need a real backend URL here instead, AND that
# backend's CORS allow-list (SecurityConfig / APP_CORS_ALLOWED_ORIGINS)
# would need to include wherever the frontend is hosted.
# VITE_API_BASE_URL=https://home-manager-1.onrender.com/api
